---
import { getImage } from "astro:assets";
import RecipeView from "@/components/recipe/view.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllIngredients } from "@/lib/ingredients-data";
import {
	breadcrumbJsonLd,
	cleanText,
	ingredientArticleJsonLd,
	truncateDescription,
} from "@/lib/seo";
import type { Ingredient } from "@/types/content";

export async function getStaticPaths() {
	const ingredients = await getAllIngredients();
	return ingredients.map((ingredient) => ({
		params: { slug: ingredient.slug },
		props: { ingredient },
	}));
}

const { ingredient } = Astro.props;
const ingredients = await getAllIngredients();
const ingredientIndex = ingredients.reduce<Record<string, Ingredient>>(
	(acc, entry) => {
		acc[entry.slug] = entry;
		return acc;
	},
	{},
);

const ogImage = await getImage({
	src: ingredient.image,
	width: 1200,
	height: 630,
	format: "jpg",
	quality: 80,
	fit: "cover",
	position: "center",
});

const site = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL ?? "/");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const fullDescription = cleanText(ingredient.data.description);
const metaDescription = truncateDescription(fullDescription, 155);

const articleLd = ingredientArticleJsonLd(ingredient, {
	siteUrl: site.toString(),
	canonicalUrl,
	imageUrl: new URL(ogImage.src, site).toString(),
});

const breadcrumbLd = breadcrumbJsonLd(
	[
		{ name: "Home", url: "/" },
		{ name: ingredient.data.name, url: Astro.url.pathname },
	],
	site.toString(),
);
---

<BaseLayout
    title={`${ingredient.data.name} | Cocktails Guru`}
    description={metaDescription}
    ogType="article"
    openGraphImage={{
        url: ogImage.src,
        width: ogImage.attributes.width,
        height: ogImage.attributes.height,
        alt: ingredient.data.name,
    }}
>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(articleLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbLd)}
    />
    <RecipeView recipe={ingredient} ingredientIndex={ingredientIndex} />
</BaseLayout>
