---
import { getImage } from "astro:assets";
import { sortBy } from "common-stuff";
import RecipesGrid from "@/components/recipes-grid.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { recipesBySpirit, SPIRITS, type Spirit } from "@/lib/categories";
import { getAllRecipes } from "@/lib/recipes-data";
import { organizationJsonLd } from "@/lib/seo";

const allRecipes = await getAllRecipes();
const recipes = sortBy(allRecipes, (recipe) =>
	recipe.data.labels?.includes("signature"),
);

const spiritCounts: { slug: Spirit; name: string; count: number }[] =
	SPIRITS.map((spirit) => ({
		slug: spirit.slug,
		name: spirit.name,
		count: recipesBySpirit(allRecipes, spirit.slug).length,
	})).filter((entry) => entry.count > 0);

const heroRecipe =
	recipes.find((recipe) => recipe.data.labels?.includes("signature")) ??
	recipes[0];

const ogImage = heroRecipe
	? await getImage({
			src: heroRecipe.image,
			width: 1200,
			height: 630,
			format: "jpg",
			quality: 80,
			fit: "cover",
			position: "center",
		})
	: undefined;

const site = Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL ?? "/");
const organizationLd = organizationJsonLd(site.toString());
---

<BaseLayout
    title="Cocktails Guru — Signature Cocktail Recipes"
    description="Explore our curated selection of exceptional cocktail recipes, discover new favorites, and master the art of cocktail creation."
    openGraphImage={ogImage ? {
        url: ogImage.src,
        width: ogImage.attributes.width,
        height: ogImage.attributes.height,
        alt: "Cocktails Guru",
    } : undefined}
>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(organizationLd)}
    />
    <section class="mb-6 md:mb-8">
        <h1 class="font-serif text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
            Signature Cocktails
        </h1>
        <p class="mt-2 text-sm text-muted-foreground md:text-base">
            Explore standout classics and modern favorites picked for flavor,
            balance, and easy home mixing.
        </p>
    </section>

    <nav class="mb-6 flex flex-wrap items-center gap-2 md:mb-8" aria-label="Browse by base spirit">
        <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground mr-1">
            Browse
        </span>
        {spiritCounts.map((entry) => (
            <a
                href={`/cocktails/${entry.slug}/`}
                class="inline-flex items-center gap-1.5 rounded-full border border-border/60 bg-card/40 px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-border hover:bg-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
                {entry.name}
                <span class="text-muted-foreground tabular-nums">{entry.count}</span>
            </a>
        ))}
        <a
            href="/ingredients/"
            class="inline-flex items-center rounded-full border border-border/60 bg-card/40 px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-border hover:bg-accent/60 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
            By ingredient
        </a>
    </nav>

    {recipes.length > 0 && <RecipesGrid recipes={recipes} />}
</BaseLayout>
